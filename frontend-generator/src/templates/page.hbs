"use client";

import { type ComponentProps, useEffect, useRef, useState } from "react";
import { Alert, AppBar, Box, Button, Checkbox, CircularProgress, Container, Dialog, DialogActions, DialogContent, DialogTitle, FormControlLabel, MenuItem, Select, Stack, Table, TableBody, TableCell, TableHead, TableRow, TextField as MuiTextField, Toolbar, Typography } from "@mui/material";
import { domainManifest, type Entity, type RecordValue } from "./domain";
import { AssistantPanel } from "./assistant-panel";

const apiBase = process.env.NEXT_PUBLIC_API_BASE_URL ?? "";
const operation = (entity: Entity, method: string) => entity.operations.find((item) => item.method === method);
const label = (value: string) => value.replace(/([A-Z])/g, " $1").replace(/^./, (letter) => letter.toUpperCase());
const valueFor = (value: unknown) => value === null || value === undefined ? "" : String(value);

function GeneratedCrudContent() {
  const [entityName, setEntityName] = useState<string>(
    domainManifest.entities[0]?.name ?? ""
  );
  const entity: Entity = domainManifest.entities.find(
    (item) => item.name === entityName
  )!;
  const [items, setItems] = useState<RecordValue[]>([]); const [selected, setSelected] = useState<RecordValue | null>(null); const [editing, setEditing] = useState(false); const [creating, setCreating] = useState(false); const [deleting, setDeleting] = useState(false); const [loading, setLoading] = useState(false); const [error, setError] = useState(""); const [query, setQuery] = useState(""); const [filter, setFilter] = useState(""); const [sort, setSort] = useState(""); const [form, setForm] = useState<RecordValue>({}); const [relationOptions, setRelationOptions] = useState<Record<string, RecordValue[]>>({}); const [relationOptionsLoading, setRelationOptionsLoading] = useState<Record<string, boolean>>({}); const [relationOptionsError, setRelationOptionsError] = useState<Record<string, string | null>>({}); const relationOptionsRequested = useRef<Set<string>>(new Set());
  const id = entity?.attributes.find((attribute) => attribute.identifier);
  const TextField = (props: ComponentProps<typeof MuiTextField>) => { const activeFields = creating ? entity.createFields : editing ? entity.updateFields : []; const wireName = typeof props.label === "string" ? props.label : null; const field = wireName === null ? undefined : activeFields.find((candidate) => candidate.wireName === wireName); const relationTarget: string | null = field && "relationTarget" in field && typeof field.relationTarget === "string" ? String(field.relationTarget) : null; const relationEntity = relationTarget === null ? undefined : domainManifest.entities.find((candidate) => String(candidate.name) === relationTarget || String(candidate.resourceName) === relationTarget); const identifier = relationEntity?.attributes.find((attribute) => attribute.identifier); const labelAttribute = relationEntity?.attributes.find((attribute) => !attribute.identifier && (String(attribute.type).toUpperCase() === "STRING" || String(attribute.type).toUpperCase().includes("CHAR") || String(attribute.type).toUpperCase().includes("TEXT"))) ?? identifier; const options: RecordValue[] = relationTarget === null ? [] : relationOptions[relationTarget] ?? []; const relationLoading = relationTarget === null ? false : relationOptionsLoading[relationTarget] ?? false; const relationError = relationTarget === null ? null : !relationEntity ? "No se encontró la entidad relacionada." : !identifier ? "La entidad relacionada no tiene identificador." : relationOptionsError[relationTarget] ?? null; if (relationTarget !== null) return <MuiTextField {...props} select disabled={Boolean(props.disabled) || relationLoading || !relationEntity || !identifier} error={Boolean(props.error) || Boolean(relationError)} helperText={relationError ?? (relationLoading ? "Cargando opciones..." : props.helperText)}><MenuItem value="">Seleccionar...</MenuItem>{identifier && options.map((option) => { const optionValue = String(option[identifier.name]); return <MenuItem key={optionValue} value={optionValue}>{labelAttribute ? valueFor(option[labelAttribute.name]) : optionValue}</MenuItem>; })}</MuiTextField>; return <MuiTextField {...props} />; };
  const request = async (path: string, init?: RequestInit) => { const response = await fetch(`${apiBase}${path}`, { headers: { "Content-Type": "application/json" }, ...init }); if (!response.ok) throw new Error("No fue posible completar la operación solicitada."); return response.status === 204 ? undefined : response.json() as Promise<unknown>; };
  const load = async () => { if (!entity) return; setLoading(true); setError(""); try { const params = new URLSearchParams(); if (query && entity.attributes.some((field) => field.searchable)) params.set("q", query); if (filter) params.append("filter", filter); if (sort) params.append("sort", sort); const result = await request(`${operation(entity, "GET")!.path}?${params}`) as { content?: RecordValue[] } | RecordValue[]; setItems(Array.isArray(result) ? result : result.content ?? []); } catch { setError("No se pudieron consultar los datos. Intente nuevamente."); } finally { setLoading(false); } };
  const loadRelationOptions = async (relationTarget: string) => { if (relationOptions[relationTarget] || relationOptionsRequested.current.has(relationTarget)) return; relationOptionsRequested.current.add(relationTarget); setRelationOptionsLoading((current) => ({ ...current, [relationTarget]: true })); setRelationOptionsError((current) => ({ ...current, [relationTarget]: null })); try { const target = domainManifest.entities.find((candidate) => candidate.name === relationTarget || candidate.resourceName === relationTarget); if (!target) throw new Error(`No se encontró la entidad relacionada "${relationTarget}".`); const list = target.operations.find((candidate) => candidate.method === "GET" && !candidate.path.includes("{") && candidate.name.toLowerCase().startsWith("list")); if (!list) throw new Error(`No se encontró una operación LIST para "${relationTarget}".`); const separator = list.path.includes("?") ? "&" : "?"; const result = await request(`${list.path}${separator}page=0&size=100`) as { content?: RecordValue[] } | RecordValue[]; const records = Array.isArray(result) ? result : result.content ?? []; setRelationOptions((current) => ({ ...current, [relationTarget]: records })); setRelationOptionsError((current) => ({ ...current, [relationTarget]: null })); } catch (error) { relationOptionsRequested.current.delete(relationTarget); setRelationOptionsError((current) => ({ ...current, [relationTarget]: error instanceof Error ? error.message : "No se pudieron cargar las opciones relacionadas." })); } finally { setRelationOptionsLoading((current) => ({ ...current, [relationTarget]: false })); } };
  useEffect(() => { void load(); }, [entityName]);
  if (!entity) return <Container><Alert severity="warning">No hay entidades disponibles.</Alert></Container>;
  const submit = async () => {
    const action = creating ? operation(entity, "POST") : operation(entity, "PATCH");
    if (!action || (!creating && !selected) || !id) return;
    const fields = creating ? entity.createFields : entity.updateFields;
    const body = Object.fromEntries(fields.map((field) => {
      const rawValue = form[field.wireName];
      const schemaType = "schemaType" in field && typeof field.schemaType === "string" ? field.schemaType : undefined;
      const value = (schemaType === "integer" || schemaType === "number") && rawValue !== "" && rawValue !== null && rawValue !== undefined ? Number(rawValue) : rawValue;
      return [field.wireName, value];
    }));
    try {
      await request(creating ? action.path : action.path.replace("{id}", encodeURIComponent(String(selected![id.name]))), { method: action.method, body: JSON.stringify(body) });
      setCreating(false); setEditing(false); await load();
    } catch { setError("No se pudieron guardar los cambios. Intente nuevamente."); }
  };
  const remove = async () => { const action = operation(entity, "DELETE"); if (!action || !selected || !id) return; try { await request(action.path.replace("{id}", encodeURIComponent(String(selected[id.name]))), { method: "DELETE" }); setDeleting(false); setSelected(null); await load(); } catch { setError("No se pudo eliminar el registro. Intente nuevamente."); } };
  const startForm = (mode: "create" | "edit") => { const fields = mode === "create" ? entity.createFields : entity.updateFields; setForm(Object.fromEntries(fields.map((field) => [field.wireName, mode === "edit" && selected ? selected[field.wireName] : ""]))); for (const field of fields) if ("relationTarget" in field && typeof field.relationTarget === "string") void loadRelationOptions(field.relationTarget); setCreating(mode === "create"); setEditing(mode === "edit"); };
  return <Box sx={ { minHeight: "100vh", bgcolor: "grey.50" }}><AppBar position="static"><Toolbar><Typography variant="h6">Aplicación generada</Typography></Toolbar></AppBar><Container maxWidth="lg" sx={ { py: 3 }}><Stack spacing={2}><Stack direction={ { xs: "column", sm: "row" }} spacing={1}><Select value={entityName} onChange={(event) => { setEntityName(String(event.target.value)); setSelected(null); }} aria-label="Entidad">{domainManifest.entities.map((item) => <MenuItem key={item.name} value={item.name}>{label(item.name)}</MenuItem>)}</Select>{operation(entity, "POST") && <Button variant="contained" onClick={() => startForm("create")}>Crear</Button>}</Stack>{error && <Alert severity="error">{error}</Alert>}<Stack direction={ { xs: "column", md: "row" }} spacing={1}><TextField label="Buscar" value={query} onChange={(event) => setQuery(event.target.value)} disabled={!entity.attributes.some((field) => field.searchable)} /><TextField label="Filtro (campo:valor)" value={filter} onChange={(event) => setFilter(event.target.value)} /><Select value={sort} onChange={(event) => setSort(String(event.target.value))} displayEmpty><MenuItem value="">Sin orden</MenuItem>{entity.attributes.filter((field) => field.sortable).map((field) => <MenuItem key={field.name} value={`${field.name},${field.defaultSort ?? "ASC"}`}>{label(field.name)}</MenuItem>)}</Select><Button onClick={() => void load()}>Consultar</Button></Stack>{loading ? <CircularProgress aria-label="Cargando" /> : items.length === 0 ? <Alert severity="info">No hay registros.</Alert> : <Box sx={ { overflowX: "auto" }}><Table size="small"><TableHead><TableRow>{entity.attributes.map((field) => <TableCell key={field.name}>{label(field.name)}</TableCell>)}<TableCell>Acciones</TableCell></TableRow></TableHead><TableBody>{items.map((item, index) => <TableRow key={String(item[id?.name ?? "id"] ?? index)} hover onClick={() => setSelected(item)}>{entity.attributes.map((field) => <TableCell key={field.name}>{valueFor(item[field.name])}</TableCell>)}<TableCell><Button onClick={(event) => { event.stopPropagation(); setSelected(item); }}>Detalle</Button></TableCell></TableRow>)}</TableBody></Table></Box>}{selected && <Stack direction={ { xs: "column", sm: "row" }} spacing={1}><Typography variant="body1">Seleccionado: {valueFor(selected[id?.name ?? "id"])}</Typography>{operation(entity, "PATCH") && <Button onClick={() => startForm("edit")}>Editar</Button>}{operation(entity, "DELETE") && <Button color="error" onClick={() => setDeleting(true)}>Eliminar</Button>}</Stack>}</Stack></Container><Dialog open={creating || editing} onClose={() => { setCreating(false); setEditing(false); }} fullWidth maxWidth="sm"><DialogTitle>{creating ? "Crear" : "Editar"} {label(entity.name)}</DialogTitle><DialogContent><Stack spacing={2} sx={ { pt: 1 }}>{(creating ? entity.createFields : entity.updateFields).map((field) => field.schemaType === "boolean" ? <FormControlLabel key={field.wireName} control={<Checkbox checked={Boolean(form[field.wireName])} onChange={(event) => setForm({ ...form, [field.wireName]: event.target.checked })} />} label={field.wireName} /> : <TextField key={field.wireName} label={field.wireName} required={field.required} type={field.schemaType === "integer" || field.schemaType === "number" ? "number" : "text"} value={form[field.wireName] ?? ""} onChange={(event) => setForm({ ...form, [field.wireName]: event.target.value })} fullWidth />)}</Stack></DialogContent><DialogActions><Button onClick={() => { setCreating(false); setEditing(false); }}>Cancelar</Button><Button variant="contained" onClick={() => void submit()}>Guardar</Button></DialogActions></Dialog><Dialog open={deleting} onClose={() => setDeleting(false)}><DialogTitle>Confirmar eliminación</DialogTitle><DialogContent>Esta acción elimina el registro seleccionado.</DialogContent><DialogActions><Button onClick={() => setDeleting(false)}>Cancelar</Button><Button color="error" onClick={() => void remove()}>Eliminar</Button></DialogActions></Dialog></Box>;
}

export default function GeneratedCrudApp() {
  return <Stack spacing={2}><AssistantPanel /><GeneratedCrudContent /></Stack>;
}
