{
  "name": "@examen-sw1/spring-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-templates.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:generated-backend": "npm run build && node ./dist/generated-backend-smoke.js"
  },
  "dependencies": {
    "@examen-sw1/relational-core": "*",
    "handlebars": "^4.7.8",
    "openapi-to-postmanv2": "6.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
