services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: generated
      POSTGRES_USER: generated
      POSTGRES_PASSWORD: generated
    ports:
      - "5433:5432"
    volumes:
      - generated-postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U generated -d generated"]
      interval: 5s
      timeout: 5s
      retries: 12

volumes:
  generated-postgres-data:
