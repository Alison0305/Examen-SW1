generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  projects     Project[]
  memberships  ProjectMembership[]
  invitationsSent ProjectInvitation[] @relation("ProjectInvitationInvitedBy")
  mentorInteractions MentorInteraction[]
  mentorProposalsAuthored MentorProposal[] @relation("MentorProposalAuthor")
  mentorProposalsResolved MentorProposal[] @relation("MentorProposalResolvedBy")
  chatMessages ProjectChatMessage[] @relation("ProjectChatMessageAuthor")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  document  Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships ProjectMembership[]
  invitations ProjectInvitation[]
  operationReceipts ProjectOperationReceipt[]
  mentorInteractions MentorInteraction[]
  mentorProposals MentorProposal[]
  chatMessages ProjectChatMessage[]

  @@index([ownerId])
}

enum ProjectChatMessageKind {
  USER
  MENTOR
  NOTICE
  PROPOSAL
}

// CU-2P-08. A USER message has an author; MENTOR, NOTICE and PROPOSAL do not (CHECK in the migration).
// proposalId has no foreign key: proposal state is read through CU-2P-06's public API.
model ProjectChatMessage {
  id             String                 @id @default(uuid()) @db.Uuid
  projectId      String                 @db.Uuid
  kind           ProjectChatMessageKind
  authorUserId   String?                @db.Uuid
  authorEmail    String?
  body           String
  mentionsMentor Boolean                @default(false)
  replyToId      String?                @db.Uuid
  proposalId     String?                @db.Uuid
  createdAt      DateTime               @default(now())
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author         User?                  @relation("ProjectChatMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  replyTo        ProjectChatMessage?    @relation("ProjectChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        ProjectChatMessage[]   @relation("ProjectChatMessageReplies")

  @@index([projectId, createdAt, id])
  @@index([authorUserId])
}

model MentorInteraction {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  userId          String   @db.Uuid
  authorEmail     String
  accessRole      String
  occurredAt      DateTime
  projectRevision Int
  question        String
  answer          String
  grounded        Boolean
  createdAt       DateTime @default(now())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, occurredAt, id])
  @@index([userId])
}

enum MentorProposalStatus {
  PENDING
  APPLIED
  REJECTED
}

// CU-2P-06. command and summary are written once at creation; transitions only change the resolution fields.
// The status/resolution invariant is enforced by the store and by a CHECK constraint in the migration.
model MentorProposal {
  id                String               @id @default(uuid()) @db.Uuid
  projectId         String               @db.Uuid
  authorUserId      String               @db.Uuid
  authorEmail       String
  instruction       String
  baseRevision      Int
  status            MentorProposalStatus @default(PENDING)
  command           Json
  operation         Json
  summary           Json
  diagnostics       Json
  createdAt         DateTime             @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?              @db.Uuid
  resultingRevision Int?
  project           Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author            User                 @relation("MentorProposalAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  resolvedBy        User?                @relation("MentorProposalResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt, id])
  @@index([authorUserId])
  @@index([resolvedByUserId])
}

model ProjectOperationReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  operationId       String   @db.Uuid
  actorUserId       String   @db.Uuid
  baseRevision      Int
  resultingRevision Int
  fingerprint       String
  ack               Json
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, operationId])
  @@index([expiresAt])
}

enum ProjectMemberRole {
  EDITOR
  VIEWER
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

model ProjectMembership {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id          String                  @id @default(uuid()) @db.Uuid
  projectId   String                  @db.Uuid
  invitedById String                  @db.Uuid
  email       String
  role        ProjectMemberRole
  tokenHash   String
  status      ProjectInvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User                    @relation("ProjectInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([projectId, email])
  @@unique([tokenHash])
  @@index([invitedById])
}
