"use client";
import { useEffect, useState } from "react";
import { Alert, Button, Checkbox, CircularProgress, Container, Dialog, DialogActions, DialogContent, DialogTitle, FormControlLabel, MenuItem, Select, Stack, Table, TableBody, TableCell, TableHead, TableRow, TextField, Typography } from "@mui/material";
import { domainManifest, type Entity, type MutableField, type RecordValue } from "./domain";
import { getApiBase, request } from "./api";

const operation = (entity: Entity, method: string) => entity.operations.find((item) => item.method === method && !item.path.includes("{") && (method !== "GET" || item.name.toLowerCase().startsWith("list")));
const list = (value: unknown): RecordValue[] => Array.isArray(value) ? value as RecordValue[] : (value as { content?: RecordValue[] }).content ?? [];
const label = (value: string) => value.replace(/([A-Z])/g, " $1").replace(/^./, (letter) => letter.toUpperCase());
export default function GeneratedCrudApp() {
  const [entityName, setEntityName] = useState<string>(domainManifest.entities[0]?.name ?? ""); const [items, setItems] = useState<RecordValue[]>([]); const [selected, setSelected] = useState<RecordValue | null>(null); const [query, setQuery] = useState(""); const [filter, setFilter] = useState(""); const [sort, setSort] = useState(""); const [loading, setLoading] = useState(false); const [error, setError] = useState(""); const [mode, setMode] = useState<"create" | "edit" | null>(null); const [removing, setRemoving] = useState(false); const [form, setForm] = useState<RecordValue>({}); const [options, setOptions] = useState<Record<string, RecordValue[]>>({});
  const entity = domainManifest.entities.find((item) => item.name === entityName); const base = getApiBase(); const identifier = entity?.attributes.find((item) => item.identifier);
  const load = async () => { if (!entity) return; setLoading(true); setError(""); try { const params = new URLSearchParams(); if (query && entity.attributes.some((item) => item.searchable)) params.set("q", query); if (filter) params.append("filter", filter); if (sort) params.append("sort", sort); const action = operation(entity, "GET"); setItems(list(await request(action!.path + (params.size ? `?${params}` : ""), undefined, base))); } catch (cause) { setError(cause instanceof Error ? cause.message : "No se pudieron consultar los datos."); } finally { setLoading(false); } };
  useEffect(() => { setSelected(null); void load(); }, [entityName]);
  const fields = mode === "create" ? entity?.createFields ?? [] : entity?.updateFields ?? [];
  const refreshRelationOptions = async (formFields: readonly MutableField[]) => { const targets = [...new Set(formFields.flatMap((field) => field.relationTarget ? [field.relationTarget] : []))]; await Promise.all(targets.map(async (relationTarget) => { const target = domainManifest.entities.find((item) => item.name === relationTarget || item.resourceName === relationTarget); const action = target && operation(target, "GET"); if (!target || !action) return; try { const records = list(await request(`${action.path}?page=0&size=100`, undefined, base)); setOptions((current) => ({ ...current, [relationTarget]: records })); } catch { setError("No se pudieron cargar las opciones relacionadas."); } })); };
  const open = (next: "create" | "edit") => { const formFields = next === "create" ? entity?.createFields ?? [] : entity?.updateFields ?? []; setForm(Object.fromEntries(formFields.map((field) => [field.wireName, next === "edit" ? selected?.[field.wireName] ?? "" : ""]))); setMode(next); void refreshRelationOptions(formFields); };
  const save = async () => { if (!entity || !mode) return; const action = mode === "create" ? operation(entity, "POST") : entity.operations.find((item) => item.method === "PATCH" && item.path.includes("{id}")); if (!action) return; const body = Object.fromEntries(fields.map((field) => { const value = form[field.wireName]; return [field.wireName, (String(field.schemaType) === "integer" || String(field.schemaType) === "number") && value !== "" ? Number(value) : value]; })); try { await request(mode === "create" ? action.path : action.path.replace("{id}", encodeURIComponent(String(selected?.[identifier!.name]))), { method: action.method, body: JSON.stringify(body) }, base); setMode(null); await load(); } catch { setError("No se pudieron guardar los cambios."); } };
  const remove = async () => { if (!entity || !selected || !identifier) return; const action = entity.operations.find((item) => item.method === "DELETE" && item.path.includes("{id}")); if (!action) return; try { await request(action.path.replace("{id}", encodeURIComponent(String(selected[identifier.name]))), { method: "DELETE" }, base); setRemoving(false); setSelected(null); await load(); } catch { setError("No se pudo eliminar el registro."); } };
  const fieldInput = (field: MutableField) => { if (field.relationTarget) { const target = domainManifest.entities.find((item) => item.name === field.relationTarget || item.resourceName === field.relationTarget); const id = target?.attributes.find((item) => item.identifier); const text = target?.attributes.find((item) => !item.identifier && item.type === "VARCHAR") ?? id; return <TextField key={field.wireName} label={label(field.wireName)} select value={String(form[field.wireName] ?? "")} onChange={(event) => setForm({ ...form, [field.wireName]: event.target.value })}><MenuItem value="">Seleccionar...</MenuItem>{(options[field.relationTarget] ?? []).map((item) => <MenuItem key={String(item[id?.name ?? "id"])} value={String(item[id?.name ?? "id"])}>{String(item[text?.name ?? "id"])}</MenuItem>)}</TextField>; } if (String(field.schemaType) === "boolean") return <FormControlLabel key={field.wireName} label={label(field.wireName)} control={<Checkbox checked={Boolean(form[field.wireName])} onChange={(event) => setForm({ ...form, [field.wireName]: event.target.checked })} />} />; return <TextField key={field.wireName} label={label(field.wireName)} type={String(field.schemaType) === "integer" || String(field.schemaType) === "number" ? "number" : "text"} value={String(form[field.wireName] ?? "")} onChange={(event) => setForm({ ...form, [field.wireName]: event.target.value })} />; };
  if (!entity) return <Container><Alert severity="warning">No hay entidades disponibles.</Alert></Container>;
  return <Container sx={ { py: 3 }}><Stack spacing={2}><Typography variant="h5">Aplicación</Typography><Select value={entityName} onChange={(event) => setEntityName(String(event.target.value))}>{domainManifest.entities.map((item) => <MenuItem key={item.name} value={item.name}>{label(item.name)}</MenuItem>)}</Select><Stack direction="row" spacing={1}><TextField label="Buscar" value={query} disabled={!entity.attributes.some((item) => item.searchable)} onChange={(event) => setQuery(event.target.value)} /><TextField label="Filtro" value={filter} onChange={(event) => setFilter(event.target.value)} /><Select value={sort} onChange={(event) => setSort(String(event.target.value))}><MenuItem value="">Sin orden</MenuItem>{entity.attributes.filter((item) => item.sortable).map((item) => <MenuItem key={item.name} value={`${item.name},${item.defaultSort ?? "ASC"}`}>{label(item.name)}</MenuItem>)}</Select><Button onClick={() => void load()}>Consultar</Button><Button variant="contained" onClick={() => open("create")}>Crear</Button><Button disabled={!selected} onClick={() => open("edit")}>Editar</Button><Button color="error" disabled={!selected} onClick={() => setRemoving(true)}>Eliminar</Button></Stack>{error && <Alert severity="error">{error}</Alert>}{loading ? <CircularProgress /> : items.length === 0 ? <Alert severity="info">No hay registros.</Alert> : <Table><TableHead><TableRow>{entity.attributes.map((field) => <TableCell key={field.name}>{label(field.name)}</TableCell>)}</TableRow></TableHead><TableBody>{items.map((item, index) => <TableRow key={index} selected={selected === item} onClick={() => setSelected(item)}>{entity.attributes.map((field) => <TableCell key={field.name}>{String(item[field.name] ?? "")}</TableCell>)}</TableRow>)}</TableBody></Table>}<Dialog open={mode !== null} onClose={() => setMode(null)}><DialogTitle>{mode === "create" ? "Crear" : "Editar"}</DialogTitle><DialogContent><Stack spacing={1} sx={ { pt: 1 }}>{fields.map(fieldInput)}</Stack></DialogContent><DialogActions><Button onClick={() => setMode(null)}>Cancelar</Button><Button onClick={() => void save()}>Guardar</Button></DialogActions></Dialog><Dialog open={removing} onClose={() => setRemoving(false)}><DialogTitle>Confirmar eliminación</DialogTitle><DialogActions><Button onClick={() => setRemoving(false)}>Cancelar</Button><Button color="error" onClick={() => void remove()}>Eliminar</Button></DialogActions></Dialog></Stack></Container>;
}
