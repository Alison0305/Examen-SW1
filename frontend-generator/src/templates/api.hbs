const defaultBase = process.env.NEXT_PUBLIC_API_BASE_URL ?? "http://localhost:8080";
export const getApiBase = () => defaultBase;
export async function request<T>(path: string, init?: RequestInit, base = getApiBase()): Promise<T> { const response = await fetch(`${base}${path}`, { headers: { "Content-Type": "application/json" }, ...init }); if (!response.ok) throw new Error("No fue posible completar la operación solicitada."); if (response.status === 204) return undefined as T; const text = await response.text(); return text.trim() ? JSON.parse(text) as T : undefined as T; }
