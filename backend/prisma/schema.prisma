generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(uuid()) @db.Uuid
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  projects     Project[]
  memberships  ProjectMembership[]
  invitationsSent ProjectInvitation[] @relation("ProjectInvitationInvitedBy")
}

model Project {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  name      String
  document  Json
  revision  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  memberships ProjectMembership[]
  invitations ProjectInvitation[]
  operationReceipts ProjectOperationReceipt[]

  @@index([ownerId])
}

model ProjectOperationReceipt {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @db.Uuid
  operationId       String   @db.Uuid
  actorUserId       String   @db.Uuid
  baseRevision      Int
  resultingRevision Int
  fingerprint       String
  ack               Json
  createdAt         DateTime @default(now())
  expiresAt         DateTime
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, operationId])
  @@index([expiresAt])
}

enum ProjectMemberRole {
  EDITOR
  VIEWER
}

enum ProjectInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
}

model ProjectMembership {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvitation {
  id          String                  @id @default(uuid()) @db.Uuid
  projectId   String                  @db.Uuid
  invitedById String                  @db.Uuid
  email       String
  role        ProjectMemberRole
  tokenHash   String
  status      ProjectInvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime                @default(now())
  resolvedAt  DateTime?
  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy   User                    @relation("ProjectInvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@unique([projectId, email])
  @@unique([tokenHash])
  @@index([invitedById])
}
