        assertStatus(200, call("PATCH", base + "/{{idValue}}", "{{{updateJson}}}"));
        assertStatus(400, call("PATCH", base + "/{{idValue}}", "{{{patchIdentifierJson}}}"), "BAD_REQUEST");
        assertStatus(400, call("PATCH", base + "/{{idValue}}", "{{{patchNullJson}}}"), "BAD_REQUEST");
        assertStatus(200, call("GET", base + "?page=0&size=20&sort={{sortableField}},asc{{#if searchableField}}&filter={{searchableField}}:contains:{{searchValue}}&q={{searchValue}}{{/if}}", null));
        assertStatus(200, call("GET", base + "/count{{#if searchableField}}?q={{searchValue}}{{/if}}", null));
        assertStatus(400, call("GET", base + "?page=-1", null), "BAD_REQUEST");
        assertStatus(400, call("GET", base + "?size=101", null), "BAD_REQUEST");
        assertStatus(400, call("GET", base + "?sort=noExiste,asc", null), "INVALID_SORT");
        assertStatus(400, call("GET", base + "?sort={{sortableField}},sideways", null), "INVALID_SORT");
        assertStatus(400, call("GET", base + "?filter=noExiste:eq:1", null), "INVALID_FILTER");
        assertStatus(400, call("GET", base + "?filter={{sortableField}}:contains:1", null), "INVALID_FILTER");
{{#if navigationName}}        assertStatus(200, call("GET", base + "/{{idValue}}/relations/{{navigationName}}", null));
        assertStatus(400, call("GET", base + "/{{idValue}}/relations/noExiste", null), "INVALID_RELATION");
{{/if}}        String openApi = call("GET", "http://localhost:" + port + "/v3/api-docs", null).body();
        String repeatedOpenApi = call("GET", "http://localhost:" + port + "/v3/api-docs", null).body();
        Files.writeString(Path.of(System.getProperty("generated.openapi.file")), openApi);
