"use client";
import { Alert, Button, Stack, TextField, Typography } from "@mui/material";
import { useEffect, useRef, useState } from "react";
import { buildSpeechEndpoint } from "./lan-config";

export function VoiceTranscriptInput({ value, onTranscript }: Readonly<{ value: string; onTranscript: (value: string) => void }>) {
  const [state, setState] = useState("IDLE"); const [error, setError] = useState(""); const [host, setHost] = useState(""); const [port, setPort] = useState(""); const stream = useRef<MediaStream | null>(null); const recorder = useRef<MediaRecorder | null>(null); const endpoint = useRef<string | null>(null); const chunks = useRef<BlobPart[]>([]); const cancelled = useRef(false);
  function cleanup() { stream.current?.getTracks().forEach((track) => { track.removeEventListener("ended", onTrackEnded); track.stop(); }); stream.current = null; recorder.current = null; }
  function onTrackEnded() { if (!stream.current) return; cancelled.current = true; recorder.current?.stop(); cleanup(); setError("MICROPHONE_DENIED: Se perdió acceso al micrófono."); setState("ERROR"); }
  useEffect(() => () => cleanup(), []);
  const pcm = async (blob: Blob) => { const context = new AudioContext({ sampleRate: 16000 }); try { const audio = await context.decodeAudioData(await blob.arrayBuffer()); const source = audio.getChannelData(0); const output = new Int16Array(source.length); for (let i = 0; i < source.length; i += 1) output[i] = Math.max(-1, Math.min(1, source[i])) * 0x7fff; let text = ""; for (const byte of new Uint8Array(output.buffer)) text += String.fromCharCode(byte); return btoa(text); } finally { await context.close(); } };
  const recognize = async () => { if (cancelled.current || !endpoint.current) return; setState("PROCESSING"); const controller = new AbortController(); const timeout = window.setTimeout(() => controller.abort(), 10_000); try { const response = await fetch(endpoint.current, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ pcm: await pcm(new Blob(chunks.current)) }), signal: controller.signal }); if (!response.ok) throw new Error("HOST_UNAVAILABLE: El host STT no respondió correctamente."); const result = await response.json() as { state: string; transcript?: string; diagnostic?: { message: string } }; if (result.state !== "RESULT" || !result.transcript) throw new Error(result.diagnostic?.message ?? "No se pudo reconocer el audio."); if (!cancelled.current) { onTranscript(result.transcript); setState("RESULT"); } } catch (reason) { if (!cancelled.current) { const code = reason instanceof DOMException && reason.name === "AbortError" ? "TIMEOUT" : "HOST_UNAVAILABLE"; setError(`${code}: ${reason instanceof Error ? reason.message : "No se pudo alcanzar el host STT."}`); setState("ERROR"); } } finally { window.clearTimeout(timeout); cleanup(); } };
  const start = async () => { setError(""); cancelled.current = false; const configured = buildSpeechEndpoint({ host, port }); if (!configured.ok) { setError(`HOST_UNAVAILABLE: ${configured.error}`); setState("ERROR"); return; } endpoint.current = configured.endpoint; try { stream.current = await navigator.mediaDevices.getUserMedia({ audio: true }); stream.current.getTracks().forEach((track) => track.addEventListener("ended", onTrackEnded, { once: true })); const next = new MediaRecorder(stream.current); chunks.current = []; next.ondataavailable = (event) => { if (event.data.size) chunks.current.push(event.data); }; next.onstop = () => { void recognize(); }; recorder.current = next; next.start(); setState("LISTENING"); } catch (reason) { cleanup(); setError(reason instanceof DOMException && reason.name === "NotAllowedError" ? "MICROPHONE_DENIED: No se concedió acceso al micrófono." : "AUDIO_ERROR: No se pudo iniciar la captura."); setState("ERROR"); } };
  const cancel = () => { cancelled.current = true; recorder.current?.stop(); cleanup(); chunks.current = []; setError(""); setState("IDLE"); };
  return <Stack spacing={1} aria-label="Captura de voz"><Typography variant="body2">Estado de voz: {state}</Typography><TextField label="Host LAN" value={host} onChange={(event) => setHost(event.target.value)} helperText="IPv4 o nombre del host; no use localhost." /><TextField label="Puerto LAN" value={port} onChange={(event) => setPort(event.target.value)} inputMode="numeric" />{error && <Alert severity="error">{error}</Alert>}{state === "LISTENING" ? <Stack direction="row" spacing={1}><Button onClick={() => recorder.current?.stop()}>Detener voz</Button><Button onClick={cancel}>Cancelar voz</Button></Stack> : <Button variant="outlined" onClick={() => void start()} disabled={state === "PROCESSING"}>Iniciar voz</Button>}<TextField label="Texto / transcript de voz" value={value} onChange={(event) => onTranscript(event.target.value)} helperText="Revise o edite JSON AssistantCommand antes de preparar el comando." multiline minRows={2} /></Stack>;
}
