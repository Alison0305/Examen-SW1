package {{basePackage}}.dto;

public final class PatchField<T> {
    private static final PatchField<?> ABSENT = new PatchField<>(false, null);
    private final boolean present;
    private final T value;

    private PatchField(boolean present, T value) { this.present = present; this.value = value; }

    @SuppressWarnings("unchecked")
    public static <T> PatchField<T> absent() { return (PatchField<T>) ABSENT; }
    public static <T> PatchField<T> of(T value) { return new PatchField<>(true, value); }
    public boolean isPresent() { return present; }
    public T value() { return value; }
}
