"use client";

import { useRef, useState } from "react";
import { Alert, Box, Button, Dialog, DialogActions, DialogContent, DialogTitle, MenuItem, Select, Stack, TextField, Typography } from "@mui/material";
import { ASSISTANT_OPERATIONS, executeAssistantCommand, parseStructuredAssistantOutput, validateAssistantCommand, type AssistantCommand, type AssistantFields, type AssistantHttpAdapter, type AssistantHttpRequest, type AssistantResult } from "@examen-sw1/assistant-core/dist/browser.js";
import { domainManifest, type Entity } from "./domain";

type FieldRow = { id: number; fieldName: string; value: string };
const defaultApiBase = process.env.NEXT_PUBLIC_API_BASE_URL ?? "";
const apiBase = (host: string, port: string) => { const value = host.trim(); if (!value && !port.trim()) return defaultApiBase; if (!value || !/^\d+$/.test(port) || Number(port) < 1 || Number(port) > 65535 || ["localhost", "127.0.0.1", "::1"].includes(value.toLowerCase())) return ""; return `http://${value}:${port}`; };
const adapter = (base: string): AssistantHttpAdapter => ({ request: async <T = unknown>(request: AssistantHttpRequest) => { if (!base) throw new Error("Configure Host API y Puerto API antes de ejecutar."); const params = new URLSearchParams(); for (const [key, value] of request.query ?? []) params.append(key, value); const response = await fetch(`${base}${request.path}${params.size ? `?${params}` : ""}`, { method: request.method, headers: request.body ? { "Content-Type": "application/json" } : undefined, body: request.body ? JSON.stringify(request.body) : undefined }); if (response.status === 204) return { status: response.status, data: undefined }; if (!(response.headers.get("content-type") ?? "").includes("application/json")) throw new Error("La API generada no devolvió JSON."); return { status: response.status, data: await response.json() as T }; } });

export function AssistantTextProposal({ text, onTextChange, apiHost, apiPort }: Readonly<{ text: string; onTextChange: (value: string) => void; apiHost: string; apiPort: string }>) {
  const [proposal, setProposal] = useState<AssistantCommand | null>(null); const [error, setError] = useState(""); const [result, setResult] = useState<AssistantResult | null>(null); const [pendingDelete, setPendingDelete] = useState<AssistantCommand | null>(null);
  const prepare = () => { setError(""); setProposal(null); setResult(null); try { const parsed = parseStructuredAssistantOutput(JSON.parse(text)); if (!parsed.ok) { setError(parsed.message); return; } const valid = validateAssistantCommand(parsed.command, domainManifest); if (!valid.ok) { setError(valid.details?.map((detail) => detail.message).join(" ") ?? "El comando no es válido."); return; } setProposal(parsed.command); } catch { setError("El comando estructurado no es válido."); } };
  const approve = async (command: AssistantCommand, confirmDelete = false) => { const next = await executeAssistantCommand(command, domainManifest, adapter(apiBase(apiHost, apiPort)), { confirmDelete }); setResult(next); if (!next.ok && next.code === "CONFIRMATION_REQUIRED") setPendingDelete(command); else setProposal(null); };
  return <Box component="section" aria-label="Comando de datos por texto o voz"><Stack spacing={1}><TextField label="Texto / transcript de voz" value={text} onChange={(event) => onTextChange(event.target.value)} multiline minRows={2} helperText="JSON AssistantCommand estricto; por ejemplo, una operación LIST del manifest." /><Button variant="outlined" onClick={prepare} disabled={!text.trim()}>Preparar comando</Button>{error && <Alert severity="error">{error}</Alert>}{proposal && <Alert severity="info"><Typography>Comando propuesto</Typography><pre>{JSON.stringify(proposal, null, 2)}</pre><Button size="small" variant="contained" onClick={() => void approve(proposal)}>Aprobar</Button><Button size="small" onClick={() => setProposal(null)}>Cancelar</Button></Alert>}{result && <Alert severity={result.ok ? "success" : "error"}><pre>{JSON.stringify(result, null, 2)}</pre></Alert>}</Stack><Dialog open={pendingDelete !== null} onClose={() => setPendingDelete(null)}><DialogTitle>Confirmar eliminación</DialogTitle><DialogContent>Esta operación eliminará el registro seleccionado.</DialogContent><DialogActions><Button onClick={() => setPendingDelete(null)}>Cancelar</Button><Button color="error" onClick={() => void approve(pendingDelete!, true)}>Confirmar eliminación</Button></DialogActions></Dialog></Box>;
}

export function AssistantPanel({ apiHost, apiPort }: Readonly<{ apiHost: string; apiPort: string }>) {
  const [operation, setOperation] = useState<(typeof ASSISTANT_OPERATIONS)[number]>("LIST"); const [entityName, setEntityName] = useState<string>(domainManifest.entities[0]?.name ?? ""); const [identifier, setIdentifier] = useState(""); const [query, setQuery] = useState(""); const [relation, setRelation] = useState(""); const [fieldRows, setFieldRows] = useState<FieldRow[]>([]); const [uiError, setUiError] = useState(""); const [result, setResult] = useState<AssistantResult | null>(null); const [pendingDelete, setPendingDelete] = useState<AssistantCommand | null>(null); const nextRowId = useRef(1);
  const entity: Entity | undefined = domainManifest.entities.find((item) => item.name === entityName); const editable = operation !== "UPDATE" ? entity?.attributes ?? [] : entity?.attributes.filter((attribute) => !attribute.identifier) ?? [];
  const identifierValue = () => entity?.attributes.find((attribute) => attribute.identifier)?.type === "BIGINT" || entity?.attributes.find((attribute) => attribute.identifier)?.type === "NUMERIC" ? Number(identifier) : identifier;
  const buildFields = (): AssistantFields | null => { if (!entity) return null; const fields: Record<string, string | number | boolean> = {}; const names = new Set<string>(); for (const row of fieldRows) { if (!row.fieldName && !row.value) continue; if (!row.fieldName || !row.value) { setUiError("Cada fila debe tener atributo y valor."); return null; } if (names.has(row.fieldName)) { setUiError("No se permiten atributos duplicados."); return null; } const attribute = entity.attributes.find((candidate) => candidate.name === row.fieldName); if (!attribute) { setUiError("El atributo seleccionado no existe."); return null; } const value = attribute.type === "BIGINT" || attribute.type === "NUMERIC" ? Number(row.value) : attribute.type === "BOOLEAN" ? row.value === "true" : row.value; if (typeof value === "number" && (row.value === "" || Number.isNaN(value))) { setUiError("El valor numérico no es válido."); return null; } names.add(row.fieldName); fields[row.fieldName] = value; } return fields; };
  const execute = async (command?: AssistantCommand, confirmDelete = false) => { setUiError(""); const fields = ["CREATE", "UPDATE", "SEARCH"].includes(operation) ? buildFields() : {}; if (fields === null) return; const relationScope = relation && operation === "LIST" ? { name: relation, sourceIdentifier: identifierValue() } : undefined; const next = command ?? (operation === "LIST" ? { operation, entity: entityName, relation: relationScope } : operation === "GET" ? { operation, entity: entityName, identifier: identifierValue() } : operation === "SEARCH" ? { operation, entity: entityName, criteria: { query: query || undefined, ...(Object.keys(fields).length ? { fields } : {}) } } : operation === "CREATE" ? { operation, entity: entityName, fields } : operation === "UPDATE" ? { operation, entity: entityName, identifier: identifierValue(), fields } : operation === "DELETE" ? { operation, entity: entityName, identifier: identifierValue() } : { operation, entity: entityName }) as AssistantCommand; const nextResult = await executeAssistantCommand(next, domainManifest, adapter(apiBase(apiHost, apiPort)), { confirmDelete }); setResult(nextResult); if (!nextResult.ok && nextResult.code === "CONFIRMATION_REQUIRED") setPendingDelete(next); };
  const reset = () => { setFieldRows([]); setUiError(""); setResult(null); };
  const fieldInputs = ["CREATE", "UPDATE", "SEARCH"].includes(operation) ? <Stack spacing={1}>{fieldRows.map((row) => { const attribute = entity?.attributes.find((item) => item.name === row.fieldName); const selected = fieldRows.filter((item) => item.id !== row.id).map((item) => item.fieldName); return <Stack key={row.id} direction={ { xs: "column", sm: "row" }} spacing={1}><Select value={row.fieldName} onChange={(event) => setFieldRows((rows) => rows.map((item) => item.id === row.id ? { ...item, fieldName: String(event.target.value), value: "" } : item))} displayEmpty><MenuItem value="">Atributo</MenuItem>{editable.map((item) => <MenuItem key={item.name} value={item.name} disabled={selected.includes(item.name)}>{item.name}</MenuItem>)}</Select>{attribute?.type === "BOOLEAN" ? <Select value={row.value} onChange={(event) => setFieldRows((rows) => rows.map((item) => item.id === row.id ? { ...item, value: String(event.target.value) } : item))}><MenuItem value="true">true</MenuItem><MenuItem value="false">false</MenuItem></Select> : <TextField type={attribute?.type === "BIGINT" || attribute?.type === "NUMERIC" ? "number" : "text"} value={row.value} onChange={(event) => setFieldRows((rows) => rows.map((item) => item.id === row.id ? { ...item, value: event.target.value } : item))} />}<Button onClick={() => setFieldRows((rows) => rows.filter((item) => item.id !== row.id))}>Eliminar</Button></Stack>; })}<Button onClick={() => setFieldRows((rows) => [...rows, { id: nextRowId.current++, fieldName: "", value: "" }])}>Agregar campo</Button></Stack> : null;
  return <Box component="section" aria-label="Asistente de datos"><Stack spacing={1}><Typography variant="h6">Asistente estructurado</Typography><Typography>Ejecuta operaciones autorizadas del modelo generado.</Typography><Stack spacing={0.5}><Typography variant="body2" fontWeight={600}>Operación</Typography><Select value={operation} onChange={(event) => { setOperation(event.target.value as typeof operation); reset(); }}>{ASSISTANT_OPERATIONS.map((item) => <MenuItem key={item} value={item}>{item}</MenuItem>)}</Select></Stack><Stack spacing={0.5}><Typography variant="body2" fontWeight={600}>Entidad</Typography><Select value={entityName} onChange={(event) => { setEntityName(String(event.target.value)); setRelation(""); setIdentifier(""); reset(); }}>{domainManifest.entities.map((item) => <MenuItem key={item.name} value={item.name}>{item.name}</MenuItem>)}</Select></Stack>{["GET", "UPDATE", "DELETE"].includes(operation) || (operation === "LIST" && relation) ? <TextField label="Identificador" value={identifier} onChange={(event) => setIdentifier(event.target.value)} /> : null}{operation === "LIST" && entity?.relations.length ? <Select value={relation} onChange={(event) => setRelation(String(event.target.value))}><MenuItem value="">Sin relación</MenuItem>{entity.relations.map((item) => <MenuItem key={item.name} value={item.name}>{item.name}</MenuItem>)}</Select> : null}{operation === "SEARCH" ? <TextField label="Búsqueda general" value={query} onChange={(event) => setQuery(event.target.value)} /> : null}{fieldInputs}{uiError && <Alert severity="error">{uiError}</Alert>}<Button variant="contained" onClick={() => void execute()}>Ejecutar</Button>{result && <Alert severity={result.ok ? "success" : "error"}><pre>{JSON.stringify(result, null, 2)}</pre></Alert>}</Stack><Dialog open={pendingDelete !== null} onClose={() => setPendingDelete(null)}><DialogTitle>Confirmar eliminación</DialogTitle><DialogContent>Esta operación eliminará el registro seleccionado.</DialogContent><DialogActions><Button onClick={() => setPendingDelete(null)}>Cancelar</Button><Button color="error" onClick={() => { if (pendingDelete) void execute(pendingDelete, true); setPendingDelete(null); }}>Eliminar</Button></DialogActions></Dialog></Box>;
}
