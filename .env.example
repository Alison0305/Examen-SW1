BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=
# Intérprete local de texto (Qwen3 GGUF + node-llama-cpp). Vacío = solo sintaxis estricta.
ASSISTANT_MODEL_PATH=
# auto | vulkan | cuda | cpu
ASSISTANT_GPU=auto
ASSISTANT_TIMEOUT_MS=120000
ASSISTANT_MAX_QUEUE=5
ASSISTANT_PRELOAD=false
# Voz Vosk local (CU-09). Python con vosk==0.3.45 (backend/requirements-vosk.txt) y carpeta del modelo, p. ej. vosk-model-small-es-0.42.
SPEECH_PYTHON_EXECUTABLE=
SPEECH_MODEL_PATH=
# Imagen a UML (CU-10): carpeta local de onnx-community/Florence-2-base-ft. Vacío = función deshabilitada.
VISION_MODEL_PATH=
# q8 (por defecto) | fp32 | fp16 | int8 | uint8 | q4; deben existir los archivos onnx con ese sufijo.
VISION_MODEL_DTYPE=q8
VISION_TIMEOUT_MS=60000
VISION_MAX_QUEUE=2
VISION_PRELOAD=false
# Límites de entrada: bytes del archivo y píxeles de la imagen original.
VISION_MAX_BYTES=5242880
VISION_MAX_INPUT_PIXELS=40000000
